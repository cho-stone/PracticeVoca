<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/alert_dialog_style"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="@dimen/primary_height"
            android:background="@drawable/alert_dialog_title_style"
            android:gravity="center"
            android:text="@string/caution"
            android:textColor="@color/black"
            android:textSize="@dimen/primary_textSize"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/add_word_view_layout_padding">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/word_text_size"
            android:text="@string/deleteWord"
            android:gravity="center"
            android:textColor="@color/black"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#66bdbdbd" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_delete_confirm"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/primary_height"
            android:layout_weight="1"
            android:background="@color/trans"
            android:gravity="center"
            android:text="@string/confirm"
            android:textColor="@color/black"
            android:textSize="@dimen/primary_textSize"
            style="?android:attr/buttonBarButtonStyle"
            tools:ignore="VisualLintButtonSize" />

        <Button
            android:id="@+id/btn_delete_close"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/primary_height"
            android:layout_weight="1"
            android:background="@color/trans"
            android:gravity="center"
            android:text="@string/close"
            android:textColor="@color/black"
            android:textSize="@dimen/primary_textSize"
            style="?android:attr/buttonBarButtonStyle"
            tools:ignore="VisualLintButtonSize" />

    </LinearLayout>

</LinearLayout>
