<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_style"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="@dimen/primary_height"
            android:background="@drawable/dialog_title_style"
            android:gravity="center"
            android:text="@string/backupData"
            android:textColor="@color/black"
            android:textSize="@dimen/primary_textSize"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/add_word_view_layout_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/word_text_size"
            android:text="@string/backupMessage"
            android:gravity="center"
            android:textColor="@color/black"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/word_text_size"
            android:text="@string/backupMessage2"
            android:gravity="center"
            android:textColor="@color/black"/>

        <TextView
            android:layout_marginTop="@dimen/fab_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/copy_code_textSize"
            android:text="@string/touch"
            android:gravity="center"
            android:textColor="@color/c_red"/>

        <TextView
            android:id="@+id/tv_UUID"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/word_view_design"
            android:clickable="true"
            android:gravity="center"
            android:padding="@dimen/clip_text_padding"
            android:text="@string/loading"
            android:textColor="@color/black"
            android:textSize="@dimen/copy_code_textSize"
            tools:ignore="TouchTargetSizeCheck" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#66bdbdbd" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_backup_confirm"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/primary_height"
            android:layout_weight="1"
            android:background="@color/trans"
            android:gravity="center"
            android:text="@string/confirm"
            android:textColor="@color/black"
            android:textSize="@dimen/primary_textSize"
            style="?android:attr/buttonBarButtonStyle"
            tools:ignore="VisualLintButtonSize" />

        <Button
            android:id="@+id/btn_backup_close"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/primary_height"
            android:layout_weight="1"
            android:background="@color/trans"
            android:gravity="center"
            android:text="@string/close"
            android:textColor="@color/black"
            android:textSize="@dimen/primary_textSize"
            style="?android:attr/buttonBarButtonStyle"
            tools:ignore="VisualLintButtonSize" />

    </LinearLayout>

</LinearLayout>
