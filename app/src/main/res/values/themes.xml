<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.PracticeVoca" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/color_toolbar</item>
        <item name="colorPrimaryVariant">@color/color_toolbar</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/c_purple</item>
        <item name="colorSecondaryVariant">@color/c_purple</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">?attr/actionBarSize</item>
    </style>

    <style name="TextInputLayoutStyle" parent="Widget.Design.TextInputLayout">
        <item name="colorControlNormal">@color/color_view_stroke</item>
        <item name="colorControlActivated">@color/color_toolbar</item>
        <item name="android:textCursorDrawable">@color/black</item>

        <item name="android:textColorHint">@color/black</item>  // hint 색
        <item name="hintTextColor">@color/black</item>

        <item name="counterTextColor">@color/black</item>
        <item name="android:textAppearance">@style/TextStyle</item>
    </style>

    <style name="TextStyle" parent="@android:style/TextAppearance">
        <item name="android:textSize">@dimen/primary_textSize</item>
        <item name="android:textColor">@color/black</item>
    </style>
</resources>